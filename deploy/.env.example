# Copy to backend/.env: cp deploy/.env.example backend/.env
# Matches deploy/docker-compose.yml: Postgres 17 on loopback, database z21, user z21.
DATABASE_URL=postgresql://z21:z21@127.0.0.1:5432/z21

# Second database for scripts and experiments. The backend never reads this line.
# Create it first:
#   docker compose exec db createdb -U z21 z21_test
# DATABASE_URL_TEST=postgresql://z21:z21@127.0.0.1:5432/z21_test
